# ===========================================================================
# 费尔瑞 FERR 运营后台 · 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore，绝不要提交到仓库。
# ===========================================================================

# --- 服务 ---
# 容器内监听端口（一般不用改，Caddy 会反代到这里）
PORT=3000
NODE_ENV=production

# --- 鉴权 ---
# JWT 签名密钥：用随机长字符串，例如 `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# 登录会话有效期（小时）
SESSION_HOURS=72

# --- 初始账号口令（首次启动 seed 用，登录后可在后台改密码）---
# 用户名固定为 li / chen / sales / boss，对应 SEO李 / SEM陈 / 销售 / 老板
SEED_LI_PASSWORD=change-me-li
SEED_CHEN_PASSWORD=change-me-chen
SEED_SALES_PASSWORD=change-me-sales
SEED_BOSS_PASSWORD=change-me-boss

# --- Anthropic AI ---
# 在 https://console.anthropic.com 申请
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 模型名（默认 claude-sonnet-4-6，可按需换成更强/更省的模型）
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1200

# --- 部署 / HTTPS（Caddy 用，本地测试可留 localhost）---
# 正式环境填你的域名，Caddy 会自动签发证书；本地测试用 localhost 走 HTTP
DOMAIN=localhost
# 申请 Let's Encrypt 证书用的邮箱（正式环境填，本地可留空）
ACME_EMAIL=
