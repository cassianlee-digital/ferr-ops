# ===========================================================================
# 费尔瑞 FERR 运营后台 · 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore，绝不要提交到仓库。
# ===========================================================================

# --- 服务 ---
# 容器内监听端口（一般不用改，Caddy 会反代到这里）
PORT=3000
NODE_ENV=production

# --- 鉴权 ---
# JWT 签名密钥：用随机长字符串，例如 `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# 登录会话有效期（小时）
SESSION_HOURS=72

# --- 初始账号口令（首次启动 seed 用，登录后可在后台改密码）---
# 用户名固定为 li / chen / manager / boss，对应 SEO李 / SEM陈 / 主管 / 老板
SEED_LI_PASSWORD=change-me-li
SEED_CHEN_PASSWORD=change-me-chen
SEED_MANAGER_PASSWORD=change-me-manager
SEED_BOSS_PASSWORD=change-me-boss

# 设置页 API 密钥的 AES 加密主密钥（可选；不填则从 JWT_SECRET 派生）
# SETTINGS_SECRET=

# --- Anthropic AI ---
# 在 https://console.anthropic.com 申请
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 模型名（默认 claude-sonnet-4-6，可按需换成更强/更省的模型）
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1200

# --- AI Provider ---
# openrouter: use OpenRouter's OpenAI-compatible API
# anthropic: use Anthropic Messages API directly
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_MAX_TOKENS=1200

# --- Google official API sync ---
# Redirect URI example: https://your-domain.com/api/google/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Google Search Console property, exactly as it appears in GSC.
# Examples: https://www.example.com/ or sc-domain:example.com
GSC_SITE_URL=

# GA4 numeric property id, not the measurement id.
GA4_PROPERTY_ID=

# Google Ads API. Keep developer token in env only; never expose it to frontend.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional when accessing a client account through MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Default is v24.1; set this if Google requires a different supported version in your account.
GOOGLE_ADS_API_VERSION=v24.1

# --- 谷歌数据定时自动同步（进程内，无需外部 cron；全部可选，留空用默认）---
# 总开关：设为 false 关闭自动同步（仍可手动点“立即同步”）。默认开启。
SYNC_AUTO=
# 每天 UTC 几点自动同步（0-23）。默认 5（≈北京 13:00）。
SYNC_DAILY_HOUR_UTC=
# 启动后若最近无新鲜的成功同步则补跑一次；设 false 关闭。默认开启。
SYNC_CATCHUP_ON_START=
# 启动补跑前的延时毫秒（等服务稳定）。默认 60000。
SYNC_START_DELAY_MS=
# 最近成功同步超过多少小时才视为“过期”需补跑。默认 20。
SYNC_STALE_HOURS=

# --- 部署 / HTTPS（Caddy 用）---
# 三种填法：
#   - 有域名（推荐）：DOMAIN=your-domain.com → Caddy 自动签发并续期 HTTPS 证书
#   - 本地测试：DOMAIN=localhost → Caddy 本地 CA 自签
#   - 仅有公网 IP、暂无域名：DOMAIN=:80 → Caddy 走纯 HTTP（无证书警告），并把下面 COOKIE_SECURE 设为 false
DOMAIN=localhost
# 申请 Let's Encrypt 证书用的邮箱（有域名的正式环境填，其它可留空）
ACME_EMAIL=
# 会话 cookie 是否要求 HTTPS。HTTPS 部署留 true；纯 HTTP（DOMAIN=:80）必须设为 false，否则无法登录
COOKIE_SECURE=true
